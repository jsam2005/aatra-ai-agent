# Copy to .env and fill in. Never commit .env.

# --- AI provider ---
# auto    = Gemini if GEMINI_API_KEY is set, otherwise offline
# gemini  = require Gemini (startup fails clearly if the key is missing)
# offline = deterministic rule-based provider, no network, no key
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# Optional: minimal | low | medium | high (leave empty for the model default)
GEMINI_THINKING_LEVEL=
# If Gemini fails mid-turn, finish the turn offline (marked "degraded") instead of returning 503.
AI_DEGRADE_TO_OFFLINE=true

# --- Demo admin key: required for knowledge-base writes and feedback analytics ---
ADMIN_API_KEY=nimbus-admin-demo

# --- Storage ---
DATABASE_URL=sqlite:///./support_agent.db
SEED_ON_STARTUP=true
